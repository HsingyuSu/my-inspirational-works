import numpy as np
import hashlib
import secrets
import time
import platform
import matplotlib
import matplotlib.pyplot as plt
from matplotlib.widgets import Button

# 字体配置

def _setup_chinese_font():
    system = platform.system()
    if system == "Windows":
        font = "Microsoft YaHei"
    elif system == "Darwin":
        font = "PingFang SC"
    else:
        font = "WenQuanYi Micro Hei"

    from matplotlib.font_manager import fontManager
    available = {f.name for f in fontManager.ttflist}

    if font in available:
        plt.rcParams["font.sans-serif"] = [font, "DejaVu Sans"]
        plt.rcParams["font.monospace"] = [font, "DejaVu Sans Mono"]
        print(f"[字体] 统一加载: {font}")
    else:
        plt.rcParams["font.sans-serif"] = ["SimHei", "DejaVu Sans"]
        plt.rcParams["font.monospace"] = ["SimHei", "DejaVu Sans Mono"]
        print("[字体] 未找到首选字体，使用 SimHei 兜底")

    plt.rcParams["axes.unicode_minus"] = False

_setup_chinese_font()


# 1. 核心博弈引擎

GESTURES = {1: "石头", 2: "剪刀", 3: "布"}
COUNTER = {1: 3, 2: 1, 3: 2}
WEIGHTS = np.array([0.4, 0.2, 0.2, 0.2])


class RPSBrain:
    def __init__(self):
        self.history = []
        self.global_count = np.ones(3) * 1e-6
        self.bigram_count = np.ones((3, 3)) * 1e-6
        self.trigram_count = np.ones((3, 3, 3)) * 1e-6
        self.bayesian_prior = np.array([1 / 3, 1 / 3, 1 / 3])
        self.commitment = None
        self.salt = None
        self.locked_choice = None
        self.lock_timestamp_ns = None
        self.stats = {"ai": 0, "user": 0, "tie": 0, "round": 0}
        # 整一个反预测系统
        self.anti_predict_mode = False
        self.result_window = []

    def pre_commit(self):
        probs = self._calc_probs()
        fused = self._fuse_probs(probs)
        if not self.anti_predict_mode:
            predicted_player = int(np.argmax(fused) + 1)
            self.locked_choice = COUNTER[predicted_player]
        else:
            self.locked_choice = self._anti_predict_choice(probs)

        self.salt = secrets.token_hex(16)
        self.lock_timestamp_ns = time.time_ns()
        commit_str = f"{self.locked_choice}:{self.salt}"
        self.commitment = hashlib.sha256(commit_str.encode()).hexdigest()[:16]
        return self.commitment

    def _anti_predict_choice(self, probs):
        model_indices = [1, 2, 3]  # 一阶、二阶、贝叶斯，分别列出来
        neg_dists = []
        for idx in model_indices:
            p = probs[idx]
            neg = 1.0 - p
            neg /= neg.sum()
            neg_dists.append(neg)
        avg_dist = np.mean(neg_dists, axis=0)
        avg_dist /= avg_dist.sum()
        choice_idx = np.random.choice(3, p=avg_dist)
        return choice_idx + 1

    def reveal(self, user_choice: int) -> dict:
        verify_str = f"{self.locked_choice}:{self.salt}"
        expected = hashlib.sha256(verify_str.encode()).hexdigest()[:16]
        verified = (expected == self.commitment)

        ai_c = self.locked_choice
        if ai_c == COUNTER[user_choice]:
            result = "ai"
        elif user_choice == COUNTER[ai_c]:
            result = "user"
        else:
            result = "tie"

        self.stats[result] += 1
        self.stats["round"] += 1

        # 电脑连输两局就切换逻辑增加鲁棒性
        self.result_window.append(result)
        if len(self.result_window) > 2:
            self.result_window.pop(0)

        if (not self.anti_predict_mode and
                len(self.result_window) == 2 and
                self.result_window == ["user", "user"]):
            self.anti_predict_mode = True

        if self.anti_predict_mode and len(self.result_window) == 2:
            last_two = self.result_window
            if last_two == ["ai", "ai"]:
                self.anti_predict_mode = False
            elif set(last_two) == {"ai", "tie"}:
                self.anti_predict_mode = False

        snapshot = {
            "verified": verified, "ai_choice": ai_c, "user_choice": user_choice,
            "result": result, "salt": self.salt, "commitment": self.commitment,
            "lock_time_ns": self.lock_timestamp_ns,
            "model_probs": self._calc_probs(),
            "fused_prob": self._fuse_probs(self._calc_probs()),
            "history_len_at_lock": len(self.history),
            "stats": self.stats.copy(),
            "anti_predict_mode": self.anti_predict_mode,
            "result_window": self.result_window.copy()
        }
        self._update(user_choice)
        return snapshot

    def _calc_probs(self):
        probs = [self.global_count / self.global_count.sum()]
        if len(self.history) >= 1:
            row = self.bigram_count[self.history[-1] - 1]
            probs.append(row / row.sum())
        else:
            probs.append(np.ones(3) / 3)
        if len(self.history) >= 2:
            row = self.trigram_count[self.history[-2] - 1][self.history[-1] - 1]
            probs.append(row / row.sum())
        else:
            probs.append(np.ones(3) / 3)
        if len(self.history) >= 5:
            lk = np.zeros(3)
            for g in self.history[-5:]:
                lk[g - 1] += 1
            lk = (lk + 1e-6) / (lk.sum() + 3e-6)
        else:
            lk = np.ones(3) / 3
        post = lk * self.bayesian_prior
        probs.append(post / post.sum())
        return probs

    def _fuse_probs(self, probs):
        w = WEIGHTS.copy()
        if len(self.history) < 2:
            w = np.array([0.4, 0.3, 0.15, 0.15])
        elif len(self.history) < 5:
            w = np.array([0.2, 0.3, 0.25, 0.25])
        w = w / w.sum()
        return sum(wi * pi for wi, pi in zip(w, probs))

    def _update(self, user_choice):
        idx = user_choice - 1
        self.global_count[idx] += 1
        if len(self.history) >= 1:
            self.bigram_count[self.history[-1] - 1][idx] += 1
        if len(self.history) >= 2:
            self.trigram_count[self.history[-2] - 1][self.history[-1] - 1][idx] += 1
        self.bayesian_prior = self._fuse_probs(self._calc_probs()).copy()
        self.history.append(user_choice)


# 2. 双窗口 GUI 控制器

class RPSGui:
    C = {
        "bg": "#0d1117", "panel": "#161b22", "border": "#30363d",
        "text": "#c9d1d9", "text_dim": "#8b949e",
        "accent": "#58a6ff", "win": "#3fb950", "lose": "#f85149", "tie": "#d29922",
        "bar_colors": ["#58a6ff", "#3fb950", "#f85149", "#bc8cff"]
    }
    MODEL_NAMES = ["全局统计", "二元组", "三元组", "贝叶斯"]

    def __init__(self, debug_visible=False):
        self.brain = RPSBrain()
        self.debug_visible = debug_visible

        #主窗口 (Public)
        self.main_fig = plt.figure(figsize=(10, 6), facecolor=self.C["bg"])
        self.main_fig.canvas.manager.set_window_title("石头剪刀布 - 可信AI")

        gs_main = self.main_fig.add_gridspec(2, 1, height_ratios=[2, 1], hspace=0.25,
                                             left=0.08, right=0.92, top=0.92, bottom=0.08)
        self.ax_main_status = self.main_fig.add_subplot(gs_main[0])
        self.ax_main_btns = self.main_fig.add_subplot(gs_main[1])
        self.ax_main_btns.axis('off')

        # 三个出拳按钮
        btn_labels = ["[1] 石头", "[2] 剪刀", "[3] 布"]
        btn_positions = [
            [0.15, 0.1, 0.2, 0.15],
            [0.40, 0.1, 0.2, 0.15],
            [0.65, 0.1, 0.2, 0.15]
        ]
        self.main_btns = []
        for idx, (pos, label) in enumerate(zip(btn_positions, btn_labels)):
            ax_btn = self.main_fig.add_axes(pos)
            btn = Button(ax_btn, label, color=self.C["panel"], hovercolor=self.C["accent"])
            btn.label.set_color(self.C["text"])
            btn.label.set_fontsize(14)
            btn.label.set_fontweight("bold")
            btn.on_clicked(lambda _, c=idx+1: self._on_user_choice(c))
            self.main_btns.append(btn)

        # 调试窗口 (private)
        if self.debug_visible:
            self.debug_fig = plt.figure(figsize=(13, 7), facecolor=self.C["bg"])
            self.debug_fig.canvas.manager.set_window_title("调试 - AI预测详情")
            gs_debug = self.debug_fig.add_gridspec(2, 2, hspace=0.3, wspace=0.25,
                                                   left=0.06, right=0.95, top=0.92, bottom=0.08,
                                                   height_ratios=[2, 2])
            self.ax_probs = self.debug_fig.add_subplot(gs_debug[0, :])
            self.ax_debug = self.debug_fig.add_subplot(gs_debug[1, 0])
            self.ax_extra = self.debug_fig.add_subplot(gs_debug[1, 1])
        else:
            self.ax_probs = self.ax_debug = self.ax_extra = None

        # 初始化样式和第一轮
        self._style_axes()
        self._do_pre_commit()

    def _style_axes(self):
        """统一设面板样式"""
        for ax in [self.ax_main_status]:
            ax.set_facecolor(self.C["panel"])
            ax.tick_params(colors=self.C["text_dim"])
            for spine in ax.spines.values():
                spine.set_color(self.C["border"])
                spine.set_linewidth(0.8)
        if self.debug_visible:
            for ax in [self.ax_probs, self.ax_debug, self.ax_extra]:
                ax.set_facecolor(self.C["panel"])
                ax.tick_params(colors=self.C["text_dim"])
                for spine in ax.spines.values():
                    spine.set_color(self.C["border"])

    def _draw_panel_bg(self, ax, title=""):
        ax.set_facecolor(self.C["panel"])
        if title:
            ax.set_title(title, color=self.C["accent"], fontsize=12,
                         fontweight="bold", pad=12, loc="left")

    def _do_pre_commit(self):
        "新的轮次"
        commitment = self.brain.pre_commit()
        self.ax_main_status.cla()
        self._draw_panel_bg(self.ax_main_status)
        self.ax_main_status.axis("off")

        s = self.brain.stats
        # 玩家可见部分
        display = (
            f"AI 已锁定决策\n"
            f"承诺哈希: {commitment}\n"
            f"----------------------------------------\n"
            f"比分: AI {s['ai']} 胜  /  你 {s['user']} 胜  /  平 {s['tie']} 局\n"
            f"第 {s['round']+1} 局\n"
            f"----------------------------------------\n"
            f"请点击下方按钮出拳"
        )
        self.ax_main_status.text(0.5, 0.5, display,
                                 transform=self.ax_main_status.transAxes,
                                 ha="center", va="center", fontsize=13,
                                 color=self.C["text"], linespacing=2.0,
                                 fontfamily="monospace", fontweight="bold")
        self.main_fig.canvas.draw_idle()


    def _on_user_choice(self, choice):
        """玩家出拳后的完整流程"""
        snapshot = self.brain.reveal(choice)
        self._render_main_result(snapshot)          # 主窗口showcase
        if self.debug_visible:
            self._render_probs(snapshot)            # 预测更新
            self._render_debug(snapshot)            # 调试窗口更新快照
        self.main_fig.canvas.draw_idle()
        if self.debug_visible:
            self.debug_fig.canvas.draw_idle()
        plt.pause(2.5)                              # 每轮之间2.5s gap
        self._do_pre_commit()

    def _render_main_result(self, snap):
        """主窗口"""
        self.ax_main_status.cla()
        self._draw_panel_bg(self.ax_main_status)
        self.ax_main_status.axis("off")

        result_map = {"ai": ("AI 获胜", self.C["lose"]),
                      "user": ("你赢了!", self.C["win"]),
                      "tie": ("平  局", self.C["tie"])}
        result_text, result_color = result_map[snap["result"]]
        verify_tag = "验证通过" if snap["verified"] else "验证失败"

        user_g = GESTURES[snap["user_choice"]]
        ai_g = GESTURES[snap["ai_choice"]]
        # 只显示部分salt以保护隐私
        salt_short = snap["salt"][:8] + "..."

        display = (
            f"========================================\n"
            f"  你: {user_g}    VS    AI: {ai_g}\n"
            f"========================================\n"
            f"  结果: {result_text}\n"
            f"  验证: {verify_tag}\n"
            f"  承诺: {snap['commitment']}\n"
            f"  盐值: {salt_short}\n"
        )
        self.ax_main_status.text(0.5, 0.5, display,
                                 transform=self.ax_main_status.transAxes,
                                 ha="center", va="center", fontsize=14,
                                 color=result_color, linespacing=1.9,
                                 fontfamily="monospace", fontweight="bold")

    #调试窗口美工设置
    def _render_probs(self, snap):
        """四模型预测概率分布"""
        self.ax_probs.cla()
        self._draw_panel_bg(self.ax_probs, "AI 四模型预测概率分布")

        x = np.arange(3)
        width = 0.17
        offsets = [-1.5 * width, -0.5 * width, 0.5 * width, 1.5 * width]

        for i, (name, color) in enumerate(zip(self.MODEL_NAMES, self.C["bar_colors"])):
            self.ax_probs.bar(x + offsets[i], snap["model_probs"][i],
                              width, label=name, color=color, alpha=0.85,
                              edgecolor="none", zorder=3)

        fused = snap["fused_prob"]
        self.ax_probs.plot(x, fused, 'o-', color="#ffffff", markersize=7,
                           linewidth=2.5, label="融合结果", zorder=5)

        self.ax_probs.set_ylim(0, 1.05)
        self.ax_probs.set_xticks(x)
        self.ax_probs.set_xticklabels(["石头", "剪刀", "布"],
                                        color=self.C["text"], fontsize=11)
        self.ax_probs.set_ylabel("概率", color=self.C["text_dim"])
        self.ax_probs.legend(loc="upper right", fontsize=8,
                             facecolor=self.C["panel"], edgecolor=self.C["border"],
                             labelcolor=self.C["text"])
        self.ax_probs.grid(axis="y", alpha=0.15, color=self.C["text_dim"])

    def _render_debug(self, snap):
        """完整debug快照与反预测状态"""
        self.ax_debug.cla()
        self._draw_panel_bg(self.ax_debug, "DEBUG 完整快照")
        self.ax_debug.axis("off")

        mode_str = "反预测 ON" if snap["anti_predict_mode"] else "正常模式"
        lines = [
            f"AI模式: {mode_str}",
            f"近期结果: {snap['result_window']}",
            f"锁定时间戳: {snap['lock_time_ns']}",
            f"历史长度: {snap['history_len_at_lock']}",
            f"融合概率: [{', '.join(f'{p:.4f}' for p in snap['fused_prob'])}]",
            "-" * 40,
            f"全局计数: [{', '.join(f'{v:.1f}' for v in self.brain.global_count)}]",
            f"贝叶斯先验: [{', '.join(f'{p:.4f}' for p in self.brain.bayesian_prior)}]",
            "-" * 40,
            f"承诺哈希: {snap['commitment']}",
            f"完整盐值: {snap['salt']}",
            f"验证: {snap['verified']}",
        ]
        self.ax_debug.text(0.05, 0.96, "\n".join(lines),
                           transform=self.ax_debug.transAxes,
                           va="top", ha="left", fontsize=9,
                           color=self.C["text_dim"], fontfamily="monospace",
                           linespacing=1.6)

        # 额外区域
        self.ax_extra.cla()
        self._draw_panel_bg(self.ax_extra, "历史胜负走势")
        self.ax_extra.axis("off")
        s = self.brain.stats
        extra_text = f"AI胜: {s['ai']}  你胜: {s['user']}  平: {s['tie']}"
        self.ax_extra.text(0.5, 0.5, extra_text,
                           transform=self.ax_extra.transAxes,
                           ha="center", va="center", fontsize=11,
                           color=self.C["text"])

    def run(self):
        plt.show()


if __name__ == "__main__":
    # 下一行改为 debug_visible=True 即可同时查看调试窗口！！
    gui = RPSGui(debug_visible=False)   # 关闭调试窗口
    gui.run()

print("All example imports succeeded.")
